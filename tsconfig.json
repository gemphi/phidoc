{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@docusaurus/*": ["node_modules/@docusaurus/*"]
    },
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ESNext"
  },
  "include": ["src/**/*", "*.ts"],
  "exclude": ["node_modules", "build"]
}
